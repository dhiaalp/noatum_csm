# Paste into Railway Variables > Raw Editor for the CMS service.
# Replace Postgres if your database service has a different name.
DATABASE_URI=${{Postgres.DATABASE_URL}}
PAYLOAD_SECRET=REPLACE_WITH_A_RANDOM_SECRET
CMS_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
# Paste the frontend public origin here to avoid circular service references.
SITE_URL=https://YOUR-FRONTEND-DOMAIN.up.railway.app
MEDIA_DIR=/app/media
